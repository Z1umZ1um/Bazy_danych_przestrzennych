MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_CLASSIC NOT_ACTIVATED
MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_2D3D    2D_GEOMETRY
MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_COORDS  <Unused>
INCLUDE [ if { {Geometry Object} == {Geometry Object} } {            puts {MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_XML *} } ]
INCLUDE [ if { {Geometry Object} == {2D Coordinate List} } {            puts {MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_2D3D 2D_GEOMETRY};            puts {MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_CLASSIC *} } ]
INCLUDE [ if { {Geometry Object} == {3D Coordinate List} } {            puts {MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_2D3D 3D_GEOMETRY};            puts {MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_CLASSIC *} } ]
INCLUDE [ if { {Geometry Object} == {2D Min/Max Box} } {            set comment {                We need to turn the COORDS which are                    minX minY maxX maxY                into a full polygon list of coordinates            };            set splitCoords [split [string trim {<Unused>}]];            if { [llength $splitCoords] > 4} {               set trimmedCoords {};               foreach item $splitCoords { if { $item != {} } {lappend trimmedCoords $item} };               set splitCoords $trimmedCoords;            };            if { [llength $splitCoords] != 4 } {                error {$(DoTheClip_WORKSPACE_NAME)_Creator: Coordinate list is expected to be a space delimited list of four numbers as 'minx miny maxx maxy' - `<Unused>' is invalid};            };            set minX [lindex $splitCoords 0];            set minY [lindex $splitCoords 1];            set maxX [lindex $splitCoords 2];            set maxY [lindex $splitCoords 3];            puts "MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_COORDS $minX $minY $minX $maxY $maxX $maxY $maxX $minY $minX $minY";            puts {MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_2D3D 2D_GEOMETRY};            puts {MACRO $(DoTheClip_WORKSPACE_NAME)_Creator_CLASSIC *} } ]
FACTORY_DEF {$($(DoTheClip_WORKSPACE_NAME)_Creator_XML)} CreationFactory    FACTORY_NAME { $(DoTheClip_WORKSPACE_NAME)_Creator_XML_Creator }    CREATE_AT_END { yes }    OUTPUT { FEATURE_TYPE _____CREATED______        @Geometry(FROM_ENCODED_STRING,<lt>?xml<space>version=<quote>1.0<quote><space>encoding=<quote>US_ASCII<quote><space>standalone=<quote>no<quote><space>?<gt><lt>geometry<gt><lt>line<gt><lt>coord<space>x=<quote>0<quote><space>y=<quote>0<quote><solidus><gt><lt>coord<space>x=<quote>1<quote><space>y=<quote>1<quote><solidus><gt><lt><solidus>line<gt><lt><solidus>geometry<gt>) }
FACTORY_DEF {$($(DoTheClip_WORKSPACE_NAME)_Creator_CLASSIC)} CreationFactory    FACTORY_NAME { $(DoTheClip_WORKSPACE_NAME)_Creator_CLASSIC_Creator }    $($(DoTheClip_WORKSPACE_NAME)_Creator_2D3D) { $($(DoTheClip_WORKSPACE_NAME)_Creator_COORDS) }    CREATE_AT_END { yes }    OUTPUT { FEATURE_TYPE _____CREATED______ }
