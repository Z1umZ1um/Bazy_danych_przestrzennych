MACRO DoTheClip_WORKSPACE_NAME $(RasterGCPClipper_WORKSPACE_NAME)_DoTheClip_2
MACRO $(DoTheClip_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(DoTheClip_WORKSPACE_NAME)_XFORMER_NAME $(RasterGCPClipper_WORKSPACE_NAME)_DoTheClip_2
MACRO $(DoTheClip_WORKSPACE_NAME)___COMPOUND_PARAMETERS 
MACRO $(DoTheClip_WORKSPACE_NAME)_CT Ground
MACRO $(DoTheClip_WORKSPACE_NAME)_PCE No
MACRO $(DoTheClip_WORKSPACE_NAME)_GB _RasterGCPClipper_groupby
MACRO $(DoTheClip_WORKSPACE_NAME)_SUB_DOC_NAME DoTheClip
MACRO $(DoTheClip_WORKSPACE_NAME)_SUB_DOC_NAME DoTheClip
