Tcl2 set {$(DoTheClip_WORKSPACE_NAME)_CoordinateConcatenator_2_elementDelim} [FME_DecodeText {<space>}];
Tcl2 proc $(DoTheClip_WORKSPACE_NAME)_CoordinateConcatenator_2_coord_list {DIM} {     global {$(DoTheClip_WORKSPACE_NAME)_CoordinateConcatenator_2_coordDelim};     global {$(DoTheClip_WORKSPACE_NAME)_CoordinateConcatenator_2_elementDelim};     set numCoords [FME_Coordinates numCoords];     set output {};     set includeX [string first {X} {X Y Z} ];     set includeY [string first {Y} {X Y Z} ];     set includeZ [string first {Z} {X Y Z} ];     if { $includeX == -1 && $includeY == -1 && $includeZ == -1 } {       FME_SetAttribute _ground $output;       return;     };     for {set i 0} {$i < $numCoords} {incr i} {         if {$includeX != -1} {          append output [FME_Coordinates getCoord x $i];         };         if {$includeY != -1} {             if {$includeX != -1} {                append output [set {$(DoTheClip_WORKSPACE_NAME)_CoordinateConcatenator_2_elementDelim}] [FME_Coordinates getCoord y $i];             } else {                append output [FME_Coordinates getCoord y $i];             };         };         if { $DIM == 3 && $includeZ != -1 } {             if { $includeX != -1 || $includeY != -1 } {                append output [set {$(DoTheClip_WORKSPACE_NAME)_CoordinateConcatenator_2_elementDelim}] [FME_Coordinates getCoord z $i];             } else {                append output [FME_Coordinates getCoord z $i];             };         };         if {$i < ($numCoords - 1)} {           append output [set {$(DoTheClip_WORKSPACE_NAME)_CoordinateConcatenator_2_coordDelim}]         };     };     FME_SetAttribute _ground $output; }
