Lookup $(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_AttributeFilterLut   <BLANK> ok   clipper ok   raster ok   "" notok   ENCODED
Tcl2 proc $(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_setFeatType {} {     global FME_FeatureType;     set ft {$(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_};     append ft [FME_EncodeText [FME_GetAttribute {"_RasterClipper_geomtype"}]];     set FME_FeatureType $ft; }
FACTORY_DEF * TestFactory    FACTORY_NAME $(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5    INPUT  FEATURE_TYPE "$(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_Pixel_No"    TEST @Lookup($(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_AttributeFilterLut,"_RasterClipper_geomtype",ENCODED_ATTR) == "ok"    OUTPUT PASSED FEATURE_TYPE * @Tcl2($(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_setFeatType)    OUTPUT FAILED FEATURE_TYPE $(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_<UNFILTERED>
FACTORY_DEF * TestFactory    FACTORY_NAME $(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_BlankFilter    INPUT FEATURE_TYPE $(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_<UNFILTERED>    TEST @Value("_RasterClipper_geomtype") == ""    OUTPUT PASSED FEATURE_TYPE $(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_<BLANK>    OUTPUT FAILED FEATURE_TYPE $(RasterGCPClipper_WORKSPACE_NAME)_AttributeFilter_5_<UNFILTERED>
