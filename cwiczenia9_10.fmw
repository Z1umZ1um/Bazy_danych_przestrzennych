Tcl2 proc $(DoTheClip_WORKSPACE_NAME)_AttributeCreator_9_fa131001_4f9b_4610_a99f_0525a1aa91a623_attrSetter { attrList } {     set attrList [string trim $attrList {()}];     set attrs [split $attrList {,} ];     foreach {attrName attrVal} $attrs {         if { [string match {*<at>*} $attrName] == 1 } {             set attrName [FME_Execute EvaluateExpression {STRING} $attrName {$(DoTheClip_WORKSPACE_NAME)_AttributeCreator_9}];         } else {             set attrName [FME_DecodeText $attrName];         };         if { [string match {*<at>*} $attrVal] == 1 } {             set attrVal [FME_Execute EvaluateExpression {STRING_ENCODED} $attrVal {$(DoTheClip_WORKSPACE_NAME)_AttributeCreator_9}];         };         FME_SetAttribute $attrName [FME_DecodeText $attrVal];     }; };
FACTORY_DEF * TeeFactory    FACTORY_NAME $(DoTheClip_WORKSPACE_NAME)_AttributeCreator_9    INPUT  FEATURE_TYPE "$(DoTheClip_WORKSPACE_NAME)_Creator_CREATED"    OUTPUT FEATURE_TYPE "$(DoTheClip_WORKSPACE_NAME)_AttributeCreator_9_OUTPUT"         "@Tcl2( $(DoTheClip_WORKSPACE_NAME)_AttributeCreator_9_fa131001_4f9b_4610_a99f_0525a1aa91a623_attrSetter {(_go,No)} )"
