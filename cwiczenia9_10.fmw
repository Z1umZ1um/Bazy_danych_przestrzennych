MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function
INCLUDE [ if {{fmebinary} == {fmebinary} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @Geometry(TO_ATTRIBUTE_BINARY,_geometry) }           } elseif {{fmebinary} == {fmehex} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @Geometry(TO_ATTRIBUTE_BINARY_HEX,_geometry) }           } elseif {{fmebinary} == {fmexml} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @Geometry(TO_ATTRIBUTE,_geometry) }           } elseif {{fmebinary} == {wkt} ||                      {fmebinary} == {wkb} ||                      {fmebinary} == {wkbhex} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @OGCGeometry(to_attribute,fmebinary,_geometry,<Unused>) }           } elseif {{fmebinary} == {GEOJSON} ||                     {fmebinary} == {ESRIJSON} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @JSONGeometry(TO_ATTRIBUTE,fmebinary,_geometry) }           } elseif {{fmebinary} == {KML} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @KMLGeometry(TO_ATTRIBUTE,_geometry,<Unused>) }           } elseif {{fmebinary} == {GEORSS_SIMPLE} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @GeoRSSGeometry(TO_ATTRIBUTE,fmebinary,_geometry,<Unused>) }           } elseif {{fmebinary} == {GML_3.1.1} ||                      {fmebinary} == {GML_3.2.1} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @GMLGeometry(TO_ATTRIBUTE,fmebinary,_geometry,<Unused>) }           } elseif {{fmebinary} == {geohash} } {               puts {MACRO $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function @GeoHash(TO_ATTRIBUTE,_geometry) }           }         ]
FACTORY_DEF * TeeFactory    FACTORY_NAME $(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor    INPUT  FEATURE_TYPE "$(RasterGCPClipper_WORKSPACE_NAME)_CLIPPER"    OUTPUT FEATURE_TYPE "$(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_OUTPUT"         $($(RasterGCPClipper_WORKSPACE_NAME)_GeometryExtractor_Function)
