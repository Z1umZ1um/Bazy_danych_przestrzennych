Tcl2 set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_9909d0bf_7d21_44a5_b98c_9e7e64942adb21_splitDelim [FME_DecodeText {<space>}];      if { [regexp {^([1-9][0-9]*s)+$} [set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_9909d0bf_7d21_44a5_b98c_9e7e64942adb21_splitDelim]] }      {         set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_9909d0bf_7d21_44a5_b98c_9e7e64942adb21_splitWidths [split [regsub -all {s$} {<space>} {}] s];         proc $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_doSplit {}         {            global $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_9909d0bf_7d21_44a5_b98c_9e7e64942adb21_splitWidths;            set source [FME_GetAttribute {"_gcps"}];            set attrNum 0;            set listName {_coords};            set attrPos 0;            foreach width [set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_9909d0bf_7d21_44a5_b98c_9e7e64942adb21_splitWidths]            {               set endPos [expr $attrPos + $width - 1];               set bit [string range $source $attrPos $endPos];               FME_SetAttribute "$listName{$attrNum}" [string trim $bit];               incr attrPos $width;               incr attrNum;            };         };      }      else      {         proc $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_doSplit {}         {            global $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_9909d0bf_7d21_44a5_b98c_9e7e64942adb21_splitDelim;            set delim [set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_9909d0bf_7d21_44a5_b98c_9e7e64942adb21_splitDelim];            set delimLength [string length $delim];            set source [FME_GetAttribute {"_gcps"}];            set keepEmptyParts [string equal {No} {No}];            set bits {};            set startIndex 0;            set nextIndex [string first $delim $source $startIndex];            while {$nextIndex >= 0} {              set part [string range $source $startIndex [expr $nextIndex-1]];              if { $keepEmptyParts || $part != \"\" } {                 lappend bits $part;              };              set startIndex [expr $nextIndex + $delimLength];              set nextIndex [string first $delim $source $startIndex];            };            set lastPart [string range $source $startIndex end];            if { $keepEmptyParts || $lastPart != \"\" } { lappend bits $lastPart };            set listName {_coords};            set attrNum 0;            foreach bit $bits            {               FME_SetAttribute "$listName{$attrNum}" [string trim $bit];               incr attrNum;            }          }       }
FACTORY_DEF * TeeFactory    FACTORY_NAME $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2    INPUT  FEATURE_TYPE "$(DoTheClip_WORKSPACE_NAME)_ListExploder_LIST_FOUND"    OUTPUT FEATURE_TYPE "$(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_OUTPUT"         @Tcl2($(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_2_doSplit)
