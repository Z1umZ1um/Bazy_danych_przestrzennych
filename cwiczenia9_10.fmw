#! <SUBDOCUMENTS>
#! <SUBDOCUMENT
#!   NAME="RasterGCPClipper"
#!   ARCGIS_COMPATIBILITY=""
#!   CATEGORY="Rasters"
#!   DESCRIPTION="&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Clips Rasters while retaining the Ground Control Point (GCP) georeferencing. &lt;/p&gt;&#10;"
#!   DOC_DYNAMIC_INPUT_ATTRS="0"
#!   DOC_EXTENTS="7028 1745"
#!   DOC_TOP_LEFT="163 -1867"
#!   FME_DOCUMENT_GUID="57249C28-40B5-48F4-900A-6630D14B19AF"
#!   FME_DOCUMENT_PRIORGUID=""
#!   FME_NAMES_ENCODING="UTF-8"
#!   FME_PROCESS_COUNT="NO_PARALLELISM"
#!   FME_PROCESS_GROUPS_ORDERED="No"
#!   FME_PROCESS_GROUP_BY=""
#!   FME_PROCESS_PRESERVE_GROUP_ATTR="No"
#!   FMX_ATTRIBUTE_PROPOGATION_MODE="AUTO"
#!   GUID="57249C28-40B5-48F4-900A-6630D14B19AF"
#!   HISTORY="Sep&lt;space&gt;20&lt;space&gt;2012,Dave&lt;space&gt;Campanas,Initial&lt;space&gt;Creation"
#!   IS_VISIBLE="false"
#!   LAST_SAVE_BUILD="FME(R) 2012 SP4 (20120926 - Build 12266 - WIN32)"
#!   LAST_SAVE_DATE="2013-01-10T13:28:20"
#!   MARKDOWN_DESCRIPTION=""
#!   MARKDOWN_USAGE=""
#!   PYTHON_COMPATIBILITY=""
#!   REPLACED_BY=""
#!   SUPPRESS_UPGRADE="false"
#!   TITLE="RasterGCPClipper"
#!   USAGE="&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The RasterGCPClipper can be used in place of a standard Clipper. Non-raster features will be discarded. Rasters without GCPs will be clipped as in the regular Clipper. Rasters that are completely inside or outside the clipping boundary will retain their original GCPs. Rasters that are clipped will have a new set of GCPs created to represent the new raster boundaries.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;/&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The transformer takes two parameters:&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;/&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Clipper in Ground or Pixel Coordinates - If Ground is chosen, the transformer will use the image GCPs to adjust these coordinates to pixel coordinates before clipping. Most raster formats have pixel 0,0 at the top left, so the Y coordinates should be less than 0.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;/&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Preserve Clippee Extents - If this parameter is set to No, the CLIPPED_INSIDE rasters will be equal to the intersections of the clippers and clippees. Otherwise, the intersections will be padded by nodata so that the extents are identical to those of the input rasters. Setting this to No will result in new GCPs being created to represent the new raster boundaries. &lt;/p&gt;&#10;"
#!   USE_MARKDOWN=""
#!   VIEW_POSITION="15 -37"
#!   XFORM_DEPRECATED="No"
#!   ZOOM_SCALE="85"
#! >
#! <GLOBAL_PARAMETERS>
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI CHOICE_OR_ATTR EXTENTS Yes%No Preserve Clippee Extents:"
#!   DEFAULT_VALUE="No"
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI OPTIONAL CHOICE_OR_ATTR UNITS Ground%Pixel Clipper in Ground or Pixel coordinates:"
#!   DEFAULT_VALUE="Ground"
#!   IS_STAND_ALONE="true"
#! />
#! </GLOBAL_PARAMETERS>
#! <USER_PARAMETERS
#!   FORM=""
#! >
#! <PARAMETER_INFO>
#!     <INFO NAME="EXTENTS" 
#!   DEFAULT_VALUE="No"
#!   SCOPE="STAND_ALONE"
#!   GENERATED_GUI_LINE="false"
#!   GUI_LINE="GUI CHOICE_OR_ATTR EXTENTS Yes%No Preserve Clippee Extents:"
#! />
#!     <INFO NAME="UNITS" 
#!   DEFAULT_VALUE="Ground"
#!   SCOPE="STAND_ALONE"
#!   GENERATED_GUI_LINE="false"
#!   GUI_LINE="GUI OPTIONAL CHOICE_OR_ATTR UNITS Ground%Pixel Clipper in Ground or Pixel coordinates:"
#! />
#! </PARAMETER_INFO>
#! </USER_PARAMETERS>
