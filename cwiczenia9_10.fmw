MACRO $(DoTheClip_WORKSPACE_NAME)___COMPOUND_PARAMETERS 
MACRO $(DoTheClip_WORKSPACE_NAME)_CT Pixel
MACRO $(DoTheClip_WORKSPACE_NAME)_PCE No
MACRO $(DoTheClip_WORKSPACE_NAME)_GB _RasterGCPClipper_groupby
MACRO $(DoTheClip_WORKSPACE_NAME)_SUB_DOC_NAME DoTheClip
MACRO $(DoTheClip_WORKSPACE_NAME)_SUB_DOC_NAME DoTheClip
