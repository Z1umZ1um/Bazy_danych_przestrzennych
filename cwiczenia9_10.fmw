Tcl2 proc $(FME_UUID_SAFE)_null_replacer { newValue} {    set attrs [split {_gcp_value} {,}];    foreach attr $attrs {      if {[FME_GetAttribute $attr] == {}} {          FME_SetAttribute $attr [FME_DecodeText $newValue]      };    }; }
