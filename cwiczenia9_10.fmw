Tcl2 set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_d2ded82d_9707_4106_abbf_1df3812302a523_splitDelim [FME_DecodeText {<semicolon>}];      if { [regexp {^([1-9][0-9]*s)+$} [set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_d2ded82d_9707_4106_abbf_1df3812302a523_splitDelim]] }      {         set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_d2ded82d_9707_4106_abbf_1df3812302a523_splitWidths [split [regsub -all {s$} {<semicolon>} {}] s];         proc $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_doSplit {}         {            global $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_d2ded82d_9707_4106_abbf_1df3812302a523_splitWidths;            set source [FME_GetAttribute {"_ground"}];            set attrNum 0;            set listName {_ground};            set attrPos 0;            foreach width [set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_d2ded82d_9707_4106_abbf_1df3812302a523_splitWidths]            {               set endPos [expr $attrPos + $width - 1];               set bit [string range $source $attrPos $endPos];               FME_SetAttribute "$listName{$attrNum}" [string trim $bit];               incr attrPos $width;               incr attrNum;            };         };      }      else      {         proc $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_doSplit {}         {            global $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_d2ded82d_9707_4106_abbf_1df3812302a523_splitDelim;            set delim [set $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_d2ded82d_9707_4106_abbf_1df3812302a523_splitDelim];            set delimLength [string length $delim];            set source [FME_GetAttribute {"_ground"}];            set keepEmptyParts [string equal {No} {No}];            set bits {};            set startIndex 0;            set nextIndex [string first $delim $source $startIndex];            while {$nextIndex >= 0} {              set part [string range $source $startIndex [expr $nextIndex-1]];              if { $keepEmptyParts || $part != \"\" } {                 lappend bits $part;              };              set startIndex [expr $nextIndex + $delimLength];              set nextIndex [string first $delim $source $startIndex];            };            set lastPart [string range $source $startIndex end];            if { $keepEmptyParts || $lastPart != \"\" } { lappend bits $lastPart };            set listName {_ground};            set attrNum 0;            foreach bit $bits            {               FME_SetAttribute "$listName{$attrNum}" [string trim $bit];               incr attrNum;            }          }       }
FACTORY_DEF * TeeFactory    FACTORY_NAME $(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3    INPUT  FEATURE_TYPE "$(DoTheClip_WORKSPACE_NAME)_CoordinateConcatenator_2_OUTPUT"    OUTPUT FEATURE_TYPE "$(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_OUTPUT"         @Tcl2($(DoTheClip_WORKSPACE_NAME)_AttributeSplitter_3_doSplit)
