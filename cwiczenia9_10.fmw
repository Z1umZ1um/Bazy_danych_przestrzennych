# Create the DomainName that this transformer will use.
# Because @Count itself will evalute the expression to calculate the
# domain, we don't need to do anything in Tcl per feature going by
INCLUDE [    set domainPrefix {};    if { {Local} == {Local} }    {       set domainPrefix [FME_EncodeText {$(RasterGCPClipper_WORKSPACE_NAME)_Counter_}];    };    puts "MACRO $(RasterGCPClipper_WORKSPACE_NAME)_Counter_FULL_DOMAIN ${domainPrefix}counter"; ]
